# ============================================================
# 码上记 CodeInterview · 部署环境变量模板（T18）
# 复制为 .env 后填写；.env 已被 .gitignore 忽略，绝不提交。
# 本机开发不需要它：本机用 backend/config/application-local.yml。
# ============================================================

# ---- 仅容器初始化 MySQL 时需要（本机 MySQL 可留空）----
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=codeinterview

# ---- 应用数据库账号（非 root）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=codeinterview
DB_PASSWORD=

# ---- 管理员首次启动初始密码（建号成功后可在个人中心改密）----
ADMIN_INIT_PASSWORD=

# ---- AI 助手（不配置 Key 时 ai.enabled 仍为 true，但 /ai/chat 返回 50201）----
AI_ENABLED=true
AI_PROVIDER=spark
AI_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
AI_MODEL=spark-x2.6
AI_API_KEY=

# ---- 运行参数 ----
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Shanghai
JAVA_OPTS=-Xms256m -Xmx512m

# ---- v3.20 用户凭证主密钥（D3）；32 字节 Base64 或 64 位十六进制 ----
# 生产环境必填：未配置时 prod 启动会直接失败，避免密钥落在容器临时层、
# 重建/换机后已保存的用户凭证全部无法解密。换机/恢复数据库前必须备份该值。
APP_ENCRYPT_KEY=

# ---- v3.20 SSRF 防护（生产必须 false；仅 mock 测试可临时置 true）----
AI_ALLOW_PRIVATE_NETWORK=false